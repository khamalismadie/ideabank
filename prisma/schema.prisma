generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdeaStatus {
  inbox
  exploring
  validated
  archived
}

model Idea {
  id          String       @id @default(uuid())
  title       String
  description String?
  content     String?
  x           Float        @default(0)
  y           Float        @default(0)
  status      IdeaStatus   @default(inbox)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  connections Connection[] @relation("Source")
  targetConns Connection[] @relation("Target")
  tags        Tag[]

  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
}

model Connection {
  id           String   @id @default(uuid())
  sourceId     String
  targetId     String
  relationship String   @default("related")
  source       Idea     @relation("Source", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Idea     @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([sourceId, targetId, relationship])
  @@index([sourceId])
  @@index([targetId])
}

model Tag {
  id        String @id @default(uuid())
  name      String @unique
  color     String @default("#6366f1")
  createdAt DateTime @default(now())
  ideas     Idea[]
}
