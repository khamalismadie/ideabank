{
  "name": "ideabank",
  "version": "0.1.0-alpha.1",
  "description": "Mindmap-powered idea management system with AI assistance",
  "private": true,
  "license": "MIT",
  "author": "Khamal",
  "repository": {
    "type": "git",
    "url": "https://github.com/khamal/ideabank"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "autoprefixer": "^10.6.1",
    "next": "^14.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "postcss": "^8.5.31",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "html-to-image": "^1.11.11",
    "zod": "^3.23.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
